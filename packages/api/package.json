{
  "name": "@repo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./build/index.js",
  "license": "ISC",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "start:aws": "prisma migrate deploy --config ../db/prisma.config.ts && node build/index.js",
    "dev": "nodemon",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --env-file=./.env.test ../../node_modules/.bin/vitest run",
    "test-debug": "node --env-file=./.env.test ../../node_modules/.bin/vitest run --reporter=verbose"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@repo/db": "workspace:*",
    "@repo/schema": "workspace:*",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "hono": "4.13.5",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/jsonwebtoken": "^9.0.7",
    "nodemon": "^3.1.6",
    "tsx": "^4.19.1",
    "vitest": "4.1.11",
    "vitest-mock-extended": "5.1.1"
  }
}
