{
  "name": "@repo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/trpc/appRouter.d.ts",
  "exports": {
    ".": {
      "types": "./build/trpc/appRouter.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "ISC",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "start:aws": "prisma migrate deploy --config ../db/prisma.config.ts && node build/index.js",
    "dev": "nodemon",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --env-file=./.env.test ../../node_modules/.bin/vitest run",
    "test-debug": "node --env-file=./.env.test ../../node_modules/.bin/vitest run --reporter=verbose"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/trpc-server": "0.4.2",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/schema": "workspace:*",
    "@trpc/server": "11.18.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "hono": "4.13.5",
    "superjson": "2.2.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "jose": "6.2.10",
    "nodemon": "^3.1.6",
    "tsx": "^4.19.1",
    "vitest": "4.1.11"
  }
}
