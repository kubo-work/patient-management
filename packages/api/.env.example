# packages/api が実行時に読み込む環境変数。
# このファイルをコピーして .env を作り、環境に応じた値を設定する。
#
#   cp .env.example .env
#
# Prisma のマイグレーション用の接続情報は packages/db/.env.example を参照。

# DB 接続文字列。Prisma Client がクエリに使う。
# Neon では pooled 接続（?pgbouncer=true&connection_limit=1 付き）を指定する。
DATABASE_URL=

# CORS の許可オリジンと express-session の secret に使われる（src/index.ts）。
# フロントエンドの URL を指定する。
CLIENT_URL=

# JWT の署名鍵。
JWT_SECRET_KEY=

# production / development / test のいずれか。
# production のときだけ Cookie が secure / sameSite=none になり、
# SERVER_DOMAIN が Cookie の domain 属性に使われる。
NODE_ENV=

# 本番で Cookie を発行するドメイン（src/doctor/login.ts, logout.ts）。
# NODE_ENV=production のときのみ参照される。未設定だと Cookie の domain が
# 付かず、フロントとバックエンドでドメインが異なる構成では認証が通らない。
SERVER_DOMAIN=
