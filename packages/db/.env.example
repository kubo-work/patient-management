# packages/db が Prisma を実行するときに読み込む接続情報。
# このファイルをコピーして .env を作り、環境に応じた値を設定する。
#
#   cp .env.example .env

# 通常のクエリ用の接続文字列。
# ローカル: compose.yaml の Postgres を指す。
# Neon    : Connection pooling を ON にした pooled 接続（ホスト名に -pooler を含む）。
#           Prisma 5 系では PgBouncer 対策として ?pgbouncer=true&connection_limit=1 を必ず付ける。
DATABASE_URL=

# migrate / db push / introspect 専用の接続文字列。
# PgBouncer はアドバイザリロックと prepared statement を扱えないため、
# スキーマ操作は必ず直結でなければならない。
# ローカル: DATABASE_URL と同じ値でよい。
# Neon    : Connection pooling を OFF にした直結（ホスト名に -pooler を含まない）。
DIRECT_URL=
